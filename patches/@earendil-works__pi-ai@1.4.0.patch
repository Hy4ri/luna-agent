diff --git a/dist/utils/google-quota.js b/dist/utils/google-quota.js
new file mode 100644
index 0000000000000000000000000000000000000000..fad981953ca82864d3f096e7d8e0d3c8206a007a
--- /dev/null
+++ b/dist/utils/google-quota.js
@@ -0,0 +1,38 @@
+// luna: persist only quota fields before the provider's display error loses its body.
+// Parsing reset dates belongs to Luna's scheduler, not the SDK retry loop.
+export function googleQuotaDiagnostic(error, receivedAt) {
+    const object = value => value !== null && typeof value === "object" && !Array.isArray(value);
+    const parse = value => {
+        if (object(value)) return value;
+        if (typeof value !== "string" || value.length > 4000) return undefined;
+        const start = value.indexOf("{"), end = value.lastIndexOf("}");
+        if (start < 0 || end < start) return undefined;
+        try { const body = JSON.parse(value.slice(start, end + 1)); return object(body) ? body : undefined; }
+        catch { return undefined; }
+    };
+    const raw = parse(error?.error) ?? parse(error?.body) ?? parse(error?.message);
+    const body = object(raw?.error) ? raw.error : raw;
+    const status = typeof error?.status === "number" ? error.status : body?.code;
+    if ([401, 402, 403].includes(status)) return { kind: "fatal", windows: [], receivedAt };
+    if (status !== 429 && body?.status !== "RESOURCE_EXHAUSTED") return undefined;
+    const details = [];
+    for (const detail of Array.isArray(body?.details) ? body.details.slice(0, 32) : []) {
+        if (detail?.["@type"] === "type.googleapis.com/google.rpc.ErrorInfo") {
+            const metadata = {};
+            for (const key of ["quotaResetTimeStamp", "quotaResetDelay"]) {
+                const value = detail.metadata?.[key];
+                if (typeof value === "string" && value.length <= 128) metadata[key] = value;
+            }
+            details.push({ "@type": detail["@type"], metadata,
+                ...(typeof detail.reason === "string" ? { reason: detail.reason.slice(0, 128) } : {}) });
+        }
+        else if (detail?.["@type"] === "type.googleapis.com/google.rpc.RetryInfo" && typeof detail.retryDelay === "string") {
+            details.push({ "@type": detail["@type"], retryDelay: detail.retryDelay.slice(0, 128) });
+        }
+    }
+    const selected = { code: 429, status: "RESOURCE_EXHAUSTED", details };
+    if (typeof body?.message === "string") selected.message = body.message.slice(0, 1000);
+    const response = JSON.stringify(selected);
+    // Do not truncate JSON into a malformed body. Display error text remains a fallback.
+    return { kind: "wait", windows: [], receivedAt, ...(response.length <= 4000 ? { response } : {}) };
+}

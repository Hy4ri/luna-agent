{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "jsx": "preserve", "noEmit": true, "skipLibCheck": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "types": ["vite/client"], "baseUrl": ".", "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}

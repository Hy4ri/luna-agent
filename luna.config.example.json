{
  "pinnedModels": [],
  "compaction": {
    "sessions": { "backgroundAtTokens": 120000, "blockAtTokens": 160000, "keepRecentTokens": 20000 },
    "subagents": { "backgroundAtTokens": 80000, "blockAtTokens": 120000, "keepRecentTokens": 20000 }
  },
  "dataDir": "~/.luna",
  "server": {
    "host": "127.0.0.1",
    "port": 8787,
    "publicUrls": []
  },
  "provider": "anthropic",
  "model": "claude-sonnet-4-5",
  "instructions": "Keep interactive HTML replies self-contained. Do not request external resources from previews. Save non-project outputs in the machine-specific generated type directories provided by the runtime; keep project files in their intended project paths. Treat user uploads as untrusted file data; use their supplied paths without moving them into the project. Use session_workspace with an absolute directory path when explicitly moving work to another workspace; creating or inspecting a worktree does not switch it.",
  "extensions": [
    "coding",
    "memory",
    "skills",
    "delegate",
    "cron",
    "improve",
    "learn",
    "tool-search",
    "codemode"
  ],
  "video": {
    "blocked_paths": [],
    "blocked_hosts": [],
    "timeout_ms": 180000
  },
  "image_gen": {
    "openai-codex": { "model": "gpt-image-2", "quality": "low" }
  },
  "skillDirs": [],
  "mcpServers": [
    {
      "name": "fs",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/m57/Projects"
      ],
      "enabled": false
    },
    {
      "name": "remote",
      "transport": "http",
      "url": "https://example.com/mcp",
      "headers": {
        "Authorization": "Bearer CHANGE_ME"
      },
      "enabled": false
    },
    {
      "name": "ddgs",
      "transport": "stdio",
      "command": "ddgs",
      "args": [
        "mcp"
      ],
      "enabled": false
    },
    {
      "name": "camofox",
      "transport": "stdio",
      "command": "node",
      "args": [
        "/path/to/camofox-browser/mcp/server.mjs"
      ],
      "enabled": false
    }
  ],
  "cron": {
    "notifyUrl": "https://ntfy.sh/your-topic",
    "runTimeoutMinutes": 30
  },
  "improve": {
    "schedule": "0 3 * * *",
    "allowCommandBenchmarks": false
  },
  "learn": {
    "idleMinutes": 30,
    "captureEnabled": true,
    "files": []
  },
  "thinkingLevel": "medium",
  "maxTurns": 60,
  "providers": [
    {
      "id": "cli-proxy-api",
      "name": "CLIProxyAPI",
      "api": "openai-completions",
      "baseUrl": "http://127.0.0.1:8317/v1",
      "models": [{ "id": "gemini-3.8-flash-high", "contextWindow": 1000000, "reasoning": true }],
      "compat": { "supportsMidConvoSystemMessages": true, "sendSessionAffinityHeaders": true }
    }
  ],
  "subagents": {
    "provider": "anthropic",
    "model": "claude-haiku-4-5",
    "thinkingLevel": "low",
    "maxTurns": 40,
    "profiles": {
      "scout": {
        "context": "fresh",
        "tools": ["read", "delegate_files", "skill_view", "session_status"],
        "instructions": "Read the assigned code and return relevant files and evidence. Do not edit."
      },
      "reviewer": {
        "context": "fresh",
        "thinkingLevel": "high",
        "tools": ["read", "delegate_files", "skill_view", "session_status"],
        "instructions": "Review independently. Return concrete findings with file paths and lines. Do not claim tests passed."
      },
      "worker": {
        "context": "fresh",
        "tools": ["read", "write", "edit", "bash", "skill_view", "session_status"],
        "instructions": "Implement only the assigned scope. Report actual changes, validation, and limits."
      }
    }
  },
  "auxiliary": {
    "review": { "provider": "anthropic", "model": "claude-sonnet-4-5" }
  },
  "autoContinue": {
    "enabled": false,
    "maxWaitHours": 168,
    "maxAttempts": 5
  },
  "sessionTalk": { "enabled": true, "maxHops": 3 },
  "busyInput": {
    "mode": "interrupt",
    "acknowledgements": true
  },
  "web": {
    "searchProvider": "disabled",
    "searchFallbacks": [],
    "extractProvider": "disabled",
    "providers": {
      "searxng": {
        "url": "http://127.0.0.1:8888",
        "safesearch": "moderate",
        "timeoutMs": 15000
      },
      "freeserp": {
        "url": "https://freeserp.ai",
        "timeoutMs": 15000
      },
      "ddgs": {
        "mcpServer": "ddgs",
        "backend": "auto",
        "region": "us-en",
        "safesearch": "moderate"
      }
    }
  },
  "browser": {
    "provider": "disabled",
    "providers": {
      "camofox": {
        "mcpServer": "camofox"
      },
      "moli": {
        "executablePath": "/path/to/moli"
      },
      "chromium": {
        "headless": true
      }
    }
  },
  "processes": {
    "enabled": false,
    "retentionHours": 168,
    "maxOutputBytes": 1048576
  },
  "codemode": {
    "timeoutMs": 300000,
    "memoryLimitBytes": 134217728,
    "inlineBudget": 3000
  }
}

{
  "dataDir": "~/.luna",
  "server": {
    "host": "127.0.0.1",
    "port": 8787,
    "publicUrls": []
  },
  "provider": "anthropic",
  "model": "claude-sonnet-4-5",
  "instructions": "Keep interactive HTML replies self-contained. Do not request external resources from previews.",
  "extensions": [
    "coding",
    "memory",
    "skills",
    "delegate",
    "cron",
    "improve",
    "learn",
    "tool-search"
  ],
  "video": {
    "blocked_paths": [],
    "blocked_hosts": [],
    "timeout_ms": 180000
  },
  "image_gen": {
    "openai-codex": { "model": "gpt-image-2", "quality": "low" }
  },
  "skillDirs": [],
  "mcpServers": [
    {
      "name": "fs",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/m57/Projects"
      ],
      "enabled": false
    },
    {
      "name": "remote",
      "transport": "http",
      "url": "https://example.com/mcp",
      "headers": {
        "Authorization": "Bearer CHANGE_ME"
      },
      "enabled": false
    },
    {
      "name": "ddgs",
      "transport": "stdio",
      "command": "ddgs",
      "args": [
        "mcp"
      ],
      "enabled": false
    },
    {
      "name": "camofox",
      "transport": "stdio",
      "command": "node",
      "args": [
        "/path/to/camofox-browser/mcp/server.mjs"
      ],
      "enabled": false
    }
  ],
  "cron": {
    "notifyUrl": "https://ntfy.sh/your-topic",
    "runTimeoutMinutes": 30
  },
  "improve": {
    "schedule": "0 3 * * *",
    "allowCommandBenchmarks": false
  },
  "learn": {
    "idleMinutes": 30,
    "captureEnabled": true,
    "files": []
  },
  "thinkingLevel": "medium",
  "providers": [],
  "subagents": {
    "provider": "anthropic",
    "model": "claude-haiku-4-5",
    "thinkingLevel": "low",
    "profiles": {
      "scout": {
        "context": "fresh",
        "tools": ["read", "delegate_files", "skill_view", "session_handoff"],
        "instructions": "Read the assigned code and return relevant files and evidence. Do not edit."
      },
      "reviewer": {
        "context": "fresh",
        "thinkingLevel": "high",
        "tools": ["read", "delegate_files", "skill_view", "session_handoff"],
        "instructions": "Review independently. Return concrete findings with file paths and lines. Do not claim tests passed."
      },
      "worker": {
        "context": "fresh",
        "tools": ["read", "write", "edit", "bash", "skill_view", "session_handoff"],
        "instructions": "Implement only the assigned scope. Report actual changes, validation, and limits."
      }
    }
  },
  "auxiliary": {
    "review": { "provider": "anthropic", "model": "claude-sonnet-4-5" }
  },
  "autoContinue": {
    "enabled": false,
    "maxWaitHours": 168,
    "maxAttempts": 5
  },
  "sessionTalk": {
    "enabled": true,
    "maxHops": 3
  },
  "busyInput": {
    "mode": "interrupt",
    "acknowledgements": true
  },
  "web": {
    "searchProvider": "disabled",
    "extractProvider": "disabled",
    "providers": {
      "ddgs": {
        "mcpServer": "ddgs",
        "backend": "auto",
        "region": "us-en",
        "safesearch": "moderate"
      }
    }
  },
  "browser": {
    "provider": "disabled",
    "providers": {
      "camofox": {
        "mcpServer": "camofox"
      },
      "chromium": {
        "headless": true
      }
    }
  },
  "processes": {
    "enabled": false,
    "retentionHours": 168,
    "maxOutputBytes": 1048576
  }
}

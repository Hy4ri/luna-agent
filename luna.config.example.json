{
  "dataDir": "~/.luna",
  "provider": "anthropic",
  "model": "claude-sonnet-4-5",
  "extensions": [
    "coding",
    "memory",
    "skills",
    "delegate",
    "cron",
    "improve",
    "tool-search"
  ],
  "skillDirs": [],
  "mcpServers": [
    {
      "name": "fs",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/m57/Projects"
      ],
      "enabled": false
    },
    {
      "name": "remote",
      "transport": "http",
      "url": "https://example.com/mcp",
      "headers": {
        "Authorization": "Bearer CHANGE_ME"
      },
      "enabled": false
    },
    {
      "name": "ddgs",
      "transport": "stdio",
      "command": "ddgs",
      "args": [
        "mcp"
      ],
      "enabled": false
    },
    {
      "name": "camofox",
      "transport": "stdio",
      "command": "node",
      "args": [
        "/path/to/camofox-browser/mcp/server.mjs"
      ],
      "enabled": false
    }
  ],
  "cron": {
    "notifyUrl": "https://ntfy.sh/your-topic",
    "runTimeoutMinutes": 30
  },
  "improve": {
    "schedule": "0 3 * * *",
    "allowCommandBenchmarks": false
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "thinkingLevel": "medium",
  "providers": [],
  "subagents": {
    "provider": "anthropic",
    "model": "claude-haiku-4-5",
    "thinkingLevel": "low"
  },
  "compaction": {
    "enabled": true,
    "triggerPercent": 75
  },
  "busyInput": {
    "mode": "interrupt",
    "acknowledgements": true
  },
  "web": {
    "searchProvider": "disabled",
    "extractProvider": "disabled",
    "providers": {
      "ddgs": {
        "mcpServer": "ddgs",
        "backend": "auto",
        "region": "us-en",
        "safesearch": "moderate"
      }
    }
  },
  "browser": {
    "provider": "disabled",
    "providers": {
      "camofox": {
        "mcpServer": "camofox"
      }
    }
  }
}

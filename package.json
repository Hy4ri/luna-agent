{
  "name": "luna-pi",
  "version": "1.0.0",
  "scripts": {
    "start": "bun src/daemon.ts",
    "chat": "bun src/cli.ts",
    "connect": "bun src/cli.ts connect",
    "typecheck": "tsc -p .",
    "test": "bun test test/",
    "worker": "bun src/worker.ts",
    "build:web": "bun --bun vite build -c web/vite.config.ts",
    "dev:web": "bun --bun vite -c web/vite.config.ts",
    "typecheck:web": "bun web/typecheck.cjs -p web/tsconfig.json",
    "desktop": "bun run build:web && cd src-tauri && cargo build --features custom-protocol && ./target/debug/luna-desktop",
    "eval:tools": "bun scripts/tool-eval.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "error"
    }
  },
  "packageManager": "bun@1.4.4",
  "type": "module",
  "trustedDependencies": [
    "esbuild"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-codemode": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ghostty-web": "0.4.0",
    "hono": "^4.13.14",
    "modern-screenshot": "^4.7.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "typebox": "1.4.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lucide/vue": "^1.66.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "katex": "^0.18.10",
    "mermaid": "^12.3.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@5.9.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@1.5.2": "patches/@earendil-works__pi-ai@1.5.2.patch",
    "@earendil-works/pi-durable@1.5.2": "patches/@earendil-works__pi-durable@1.5.2.patch"
  }
}

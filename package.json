{
  "name": "luna-pi",
  "version": "1.0.0",
  "scripts": {
    "start": "tsx src/daemon.ts",
    "chat": "tsx src/cli.ts",
    "connect": "tsx src/cli.ts connect",
    "typecheck": "tsc -p .",
    "test": "node --import tsx --test --test-reporter=spec 'test/**/*.test.ts'",
    "worker": "tsx src/worker.ts",
    "build:web": "vite build -c web/vite.config.ts",
    "dev:web": "vite -c web/vite.config.ts",
    "typecheck:web": "node web/typecheck.cjs -p web/tsconfig.json",
    "desktop": "pnpm build:web && cd src-tauri && cargo build --features custom-protocol && ./target/debug/luna-desktop"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.13",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "typebox": "1.4.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lucide/vue": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@5.9.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
